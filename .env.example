# Copy to .env for local runs. Never commit .env (it's gitignored).

# Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Telegram (@BotFather token; chat id from `npm run chat-id`)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Notion (internal integration secret + database id from the database URL)
NOTION_TOKEN=
NOTION_DATABASE_ID=

# GitHub username whose public activity becomes tweet ideas
GH_USERNAME=
# Optional locally (raises the API rate limit); set automatically in Actions
# GITHUB_TOKEN=

# TIMEZONE=Asia/Kolkata
